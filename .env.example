# Kopieer dit bestand naar .env en vul je eigen waarden in.
# De site werkt ook zonder sleutel: dan gebruikt hij de offline coach.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
PORT=4173

# Optioneel: bind op alle interfaces (nodig voor Render/deployment).
# HOST=0.0.0.0

# Optioneel: zet de AI-coach achter een toegangscode.
# ACCESS_CODE=kies-een-lange-code

# Optioneel: maximaal aantal AI-verzoeken per uur per IP-adres.
# RATE_LIMIT=30

# Optioneel: doneerlink (Ko-fi, Buy Me a Coffee, PayPal.me, Stripe Payment Link, ...).
# Zonder DONATE_URL blijft de doneerknop verborgen.
# DONATE_URL=https://ko-fi.com/jouw-naam
# DONATE_LABEL=Doneer via Ko-fi
# DONATE_NOTE=Elke bijdrage helpt om nieuwe projecten toe te voegen.

# Optioneel: rechtstreeks doneren per bankoverschrijving (bijv. Belfius).
# DONATE_IBAN=BE69 0638 3621 2278
# DONATE_NAME=Naam van de rekeninghouder
# DONATE_BANK=Belfius

# Optioneel: de publieke URL van de site (voor robots.txt en sitemap.xml).
# SITE_URL=https://easycodey.onrender.com
