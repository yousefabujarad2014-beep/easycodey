{
  "name": "easycodey",
  "version": "2.0.0",
  "private": true,
  "description": "EasyCodey - 161 Python-projecten met stap-voor-stap uitleg, een online Python-speelveld, voortgang, filters en een AI-coach",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js",
    "check": "node scripts/check-data.mjs",
    "pages": "node scripts/build-pages.mjs",
    "build": "node scripts/build-pages.mjs && node scripts/check-data.mjs",
    "icons": "node scripts/make-icons.mjs"
  },
  "engines": {
    "node": ">=18"
  }
}
